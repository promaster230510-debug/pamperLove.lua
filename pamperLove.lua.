-- =======================
-- AIM FUNCTIONS
-- =======================
local function getRoot(character)
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function getClosestPlayer()
	if not LocalPlayer.Character then return nil end
	local myRoot = getRoot(LocalPlayer.Character)
	if not myRoot then return nil end

	local closest, dist = nil, math.huge
	for _,plr in pairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local root = getRoot(plr.Character)
			if root then
				local d = (myRoot.Position - root.Position).Magnitude
				if d < dist then
					dist = d
					closest = plr
				end
			end
		end
	end
	return closest
end

-- =======================
-- CAMERA SHAKE
-- =======================
local shaking = false
local shakeConnection

local function startShake()
	if shaking then return end
	shaking = true
	shakeConnection = RunService.RenderStepped:Connect(function()
		Camera.CFrame = Camera.CFrame * CFrame.new(
			math.random(-6,6)/40,
			math.random(-6,6)/40,
			0
		)
	end)
end

local function stopShake()
	shaking = false
	if shakeConnection then
		shakeConnection:Disconnect()
	end
end

-- =======================
-- INTERACTIONS
-- =======================
StatusButton.MouseButton1Click:Connect(function()
	aimEnabled = not aimEnabled
	if aimEnabled then
		targetPlayer = getClosestPlayer()
		StatusButton.Text = "ON"
	else
		targetPlayer = nil
		StatusButton.Text = "OFF"
	end
end)

UserInputService.InputBegan:Connect(function(input,gp)
	if not gp and input.KeyCode == AIM_KEY then
		StatusButton:MouseButton1Click()
	end
end)

PrankClose.MouseButton1Click:Connect(function()
	startShake()
	KillSwitch.Visible = true
	TweenService:Create(
		PrankText,
		TweenInfo.new(0.4),
		{TextTransparency = 0}
	):Play()
end)

KillSwitch.MouseButton1Click:Connect(function()
	stopShake()
	aimEnabled = false
	targetPlayer = nil
	Blur:Destroy()
	ScreenGui:Destroy()
end)

-- =======================
-- RENDER LOOP
-- =======================
RunService.RenderStepped:Connect(function(dt)
	BorderStroke.Color = Color3.fromHSV(tick()%1,1,1)
	GlassGradient.Rotation += dt * 30
	Title.TextColor3 = Color3.fromHSV(tick()%1,1,1)

	if aimEnabled and targetPlayer and targetPlayer.Character then
		local root = getRoot(targetPlayer.Character)
		if root then
			Camera.CFrame = CFrame.new(Camera.CFrame.Position, root.Position)
		end
	end
end)
