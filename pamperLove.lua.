-- ================= AIM FUNCTIONS =================
local function getMiddlePart(c)
	return c:FindFirstChild("HumanoidRootPart")
end

local function getClosestTarget()
	if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return nil end
	local best, dist = nil, math.huge
	for _,p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local m = getMiddlePart(p.Character)
			if m then
				local d = (LocalPlayer.Character.HumanoidRootPart.Position - m.Position).Magnitude
				if d < dist then dist, best = d,p end
			end
		end
	end
	return best
end

local function aimAtTarget(t)
	if t and t.Character then
		local m = getMiddlePart(t.Character)
		if m then
			Camera.CFrame = CFrame.new(Camera.CFrame.Position, m.Position)
		end
	end
end

-- ================= AIM TOGGLE =================
local aimTween = nil
local function toggleAim()
	aimLockEnabled = not aimLockEnabled
	if aimTween then aimTween:Cancel() end
	if aimLockEnabled then
		targetPlayer = getClosestTarget()
		Status.Text = "ON"
		-- Status gradient rotation for smooth left-to-right effect
		aimTween = TweenService:Create(StatusGradient, TweenInfo.new(1,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,-1,true),{Rotation=360})
		aimTween:Play()
	else
		targetPlayer = nil
		Status.Text = "OFF"
		Status.TextColor3 = Color3.fromRGB(180,240,255)
	end
end

UserInputService.InputBegan:Connect(function(i,g)
	if i.KeyCode == AimLockKey and not g then toggleAim() end
end)
Status.MouseButton1Click:Connect(toggleAim)

-- ================= CAMERA SHAKE =================
local function startShake()
	if shaking then return end
	shaking = true
	local base = Camera.CFrame
	shakeConnection = RunService.RenderStepped:Connect(function()
		Camera.CFrame = base * CFrame.new(
			math.random(-6,6)/40,
			math.random(-6,6)/40,
			0
		)
	end)
end

local function stopShake()
	shaking = false
	if shakeConnection then
		shakeConnection:Disconnect()
		shakeConnection = nil
	end
end

Close.MouseButton1Click:Connect(function()
	startShake()
	Kill.Visible = true
	TweenService:Create(prankText, TweenInfo.new(0.4), {TextTransparency=0}):Play()
end)

Kill.MouseButton1Click:Connect(function()
	stopShake()
	aimLockEnabled = false
	targetPlayer = nil
	if aimTween then aimTween:Cancel() end
	Blur:Destroy()
	ScreenGui:Destroy()
end)

-- ================= ANIMATION LOOP =================
local t=0
RunService.RenderStepped:Connect(function(dt)
	t+=dt*2
	local hue=0.9+math.sin(t*1.6)*0.1
	BorderGlow.Color=Color3.fromHSV(hue,0.75,1)
	GlassGradient.Rotation=(t*75)%360

	if aimLockEnabled and targetPlayer then
		aimAtTarget(targetPlayer)
	end
end)
