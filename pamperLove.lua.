-- pamperLove | FINAL PREMIUM GUI

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local LP = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ===== STATE =====
local GUI_ENABLED = false
local AIM_ENABLED = false
local target = nil
local shakeConnection = nil
local shaking = false

-- ===== AIM FUNCTIONS =====
local function getClosest()
	if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return nil end
	local best, dist = nil, math.huge
	for _,p in pairs(Players:GetPlayers()) do
		if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local d = (LP.Character.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
			if d < dist then dist, best = d,p end
		end
	end
	return best
end

local function aimAt(t)
	if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
		Camera.CFrame = CFrame.new(Camera.CFrame.Position,t.Character.HumanoidRootPart.Position)
	end
end

-- ===== SHAKE FUNCTION =====
local function startShake()
	if shaking then return end
	shaking = true
	local base = Camera.CFrame
	shakeConnection = RunService.RenderStepped:Connect(function()
		Camera.CFrame = base * CFrame.new(math.random(-5,5)/50, math.random(-5,5)/50, 0)
	end)
end

local function stopShake()
	shaking = false
	if shakeConnection then shakeConnection:Disconnect() shakeConnection=nil end
end

-- ===== GUI CREATION =====
local function createGUI()
	if GUI_ENABLED then return end
	GUI_ENABLED = true

	local ScreenGui = Instance.new("ScreenGui",LP.PlayerGui)
	ScreenGui.Name = "pamperLoveGUI"
	ScreenGui.ResetOnSpawn = false

	-- Main frame
	local Main = Instance.new("Frame",ScreenGui)
	Main.Size = UDim2.fromOffset(320,160)
	Main.Position = UDim2.fromOffset(60,60)
	Main.BackgroundColor3 = Color3.fromRGB(20,20,25)
	Main.Active = true
	Main.Draggable = true
	Instance.new("UICorner",Main).CornerRadius = UDim.new(0,18)

	-- Inner dynamic glass
	local Glass = Instance.new("Frame",Main)
	Glass.Size = UDim2.new(1,-16,1,-16)
	Glass.Position = UDim2.fromOffset(8,8)
	Glass.BackgroundTransparency = 0.05
	Instance.new("UICorner",Glass).CornerRadius = UDim.new(0,16)

	local GlassGrad = Instance.new("UIGradient",Glass)
	GlassGrad.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.fromRGB(80,140,220)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(180,200,255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(220,170,255))
	}
	GlassGrad.Rotation = 0

	-- Title - glass / emboss with stroke matching background
	local Title = Instance.new("TextLabel",Main)
	Title.Size = UDim2.new(1,0,0,36)
	Title.Position = UDim2.fromOffset(0,0)
	Title.BackgroundTransparency = 1
	Title.Text = "pamperLove"
	Title.Font = Enum.Font.GothamBold
	Title.TextSize = 28
	Title.TextColor3 = Color3.fromRGB(22,22,25) -- в тон фона
	local Stroke = Instance.new("UIStroke",Title)
	Stroke.Thickness = 1.5
	Stroke.Transparency = 0
	Stroke.Color = Color3.fromRGB(200,200,255)

	-- ===== STATUS BAR =====
	local Status = Instance.new("TextButton",Main)
	Status.Size = UDim2.new(1,-40,0,36)
	Status.Position = UDim2.fromOffset(20,100)
	Status.Text = "OFF"
	Status.Font = Enum.Font.GothamSemibold
	Status.TextSize = 18
	Status.TextColor3 = Color3.fromRGB(240,240,255)
	Status.BackgroundColor3 = Color3.fromRGB(60,70,90)
	Instance.new("UICorner",Status).CornerRadius = UDim.new(0,12)

	-- Gradient inside status
	local StatusGrad = Instance.new("UIGradient",Status)
	StatusGrad.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.fromRGB(100,180,255)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(150,200,255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(90,180,240))
	}
	StatusGrad.Rotation = 0

	-- Animated side squares
	local function makeSquare(x)
		local sq = Instance.new("Frame",Status)
		sq.Size = UDim2.fromOffset(14,14)
		sq.Position = UDim2.fromScale(x,0.5)
		sq.AnchorPoint = Vector2.new(0.5,0.5)
		sq.BackgroundTransparency = 0.1
		Instance.new("UICorner",sq).CornerRadius = UDim.new(0,4)
		local stroke = Instance.new("UIStroke",sq)
		stroke.Thickness = 2
		stroke.Transparency = 0.2
		return sq, stroke
	end

	local SQ_L, SQS_L = makeSquare(0.06)
	local SQ_R, SQS_R = makeSquare(0.94)

	-- Troll top cross
	local Close = Instance.new("TextButton",Main)
	Close.Size = UDim2.fromOffset(30,30)
	Close.Position = UDim2.new(1,-40,0,6)
	Close.Text = "✖"
	Close.Font = Enum.Font.GothamBlack
	Close.TextSize = 20
	Close.BackgroundColor3 = Color3.fromRGB(220,70,70)
	Close.TextColor3 = Color3.new(1,1,1)
	Instance.new("UICorner",Close).CornerRadius = UDim.new(0,8)

	-- Kill bottom cross
	local Kill = Instance.new("TextButton",Main)
	Kill.Size = UDim2.fromOffset(34,34)
	Kill.Position = UDim2.new(0,10,1,-46)
	Kill.Text = "☠"
	Kill.Font = Enum.Font.GothamBlack
	Kill.TextSize = 20
	Kill.BackgroundColor3 = Color3.fromRGB(180,60,60)
	Kill.TextColor3 = Color3.new(1,1,1)
	Kill.Visible = false
	Instance.new("UICorner",Kill).CornerRadius = UDim.new(0,10)

	-- Prank Text
	local prankText = Instance.new("TextLabel",ScreenGui)
	prankText.Size = UDim2.new(1,0,1,0)
	prankText.BackgroundTransparency = 1
	prankText.Text = "NYASHIX PRIME"
	prankText.Font = Enum.Font.GothamBlack
	prankText.TextSize = 80
	prankText.TextColor3 = Color3.fromRGB(255,90,140)
	prankText.TextTransparency = 1
	prankText.ZIndex = 10

	-- ===== LOGIC =====
	local function toggleAim()
		AIM_ENABLED = not AIM_ENABLED
		Status.Text = AIM_ENABLED and "ON" or "OFF"
		target = AIM_ENABLED and getClosest() or nil
	end
	Status.MouseButton1Click:Connect(toggleAim)
	UIS.InputBegan:Connect(function(i,g)
		if g then return end
		if i.KeyCode == Enum.KeyCode.R then toggleAim() end
	end)

	Close.MouseButton1Click:Connect(function()
		Kill.Visible = true
		startShake()
		TweenService:Create(prankText,TweenInfo.new(0.4),{TextTransparency=0}):Play()
	end)

	Kill.MouseButton1Click:Connect(function()
		stopShake()
		AIM_ENABLED=false
		GUI_ENABLED=false
		Main:Destroy()
		prankText:Destroy()
	end)

	-- ===== RENDER =====
	RunService.RenderStepped:Connect(function()
		local t = tick()
		GlassGrad.Rotation = (t*25)%360
		local c = Color3.fromHSV((t*0.7)%1,0.9,1)
		SQ_L.BackgroundColor3 = c
		SQ_R.BackgroundColor3 = c
		SQS_L.Color = c
		SQS_R.Color = c

		if AIM_ENABLED and target then aimAt(target) end
	end)
end

-- ===== TOGGLE GUI =====
UIS.InputBegan:Connect(function(i,g)
	if g then return end
	if i.KeyCode == Enum.KeyCode.Insert then
		if GUI_ENABLED then
			for _,v in pairs(LP.PlayerGui:GetChildren()) do
				if v.Name=="pamperLoveGUI" then v:Destroy() end
			end
			AIM_ENABLED=false
			GUI_ENABLED=false
		else
			createGUI()
		end
	end
end)

createGUI()
